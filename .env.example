# Required for production OpenAI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Required for non-interactive hosted OpenSEO MCP access. The public hosted
# flow uses interactive OAuth; provision a compatible bearer token externally.
OPENSEO_ACCESS_TOKEN=
OPENSEO_MCP_URL=https://app.openseo.so/mcp

# Optional operational settings.
SEO_PIPELINE_LOG_LEVEL=INFO

# Optional on Windows: path to the official standalone WeasyPrint executable.
WEASYPRINT_EXECUTABLE=
